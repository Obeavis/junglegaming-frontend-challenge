{
  "name": "kurio-marketplace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "preview": "vite preview --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:visual:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "test:e2e:report": "playwright show-report e2e/report",
    "lighthouse": "npm run build && node scripts/lighthouse.mjs",
    "lighthouse:run": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource/roboto-mono": "5.2.8",
    "@hookform/resolvers": "5.2.2",
    "@mswjs/socket.io-binding": "0.2.0",
    "@tailwindcss/vite": "4.1.14",
    "@tanstack/react-query": "5.90.2",
    "@tanstack/react-router": "1.170.44",
    "axios": "1.12.2",
    "big.js": "7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^0.577.0",
    "msw": "2.12.14",
    "radix-ui": "^1.8.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.65.0",
    "shadcn": "^4.22.1",
    "socket.io-client": "4.8.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.14",
    "tw-animate-css": "^1.4.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@playwright/test": "^1.56.1",
    "@tanstack/router-plugin": "1.167.0",
    "@types/big.js": "6.2.2",
    "@types/node": "^22.18.8",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.2.0",
    "chrome-launcher": "^1.2.0",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.23",
    "globals": "16.4.0",
    "lighthouse": "^12.8.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "7.3.7"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "engines": {
    "node": ">=20.19"
  }
}
